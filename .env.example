# LLM provider: groq | ollama | none
# If unset: uses groq when GROQ_API_KEY is present, otherwise none (retrieval-only).
LLM_PROVIDER=

# Groq free-tier (production)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local Ollama (development)
OLLAMA_MODEL=llama3.2

# Light anti-abuse rate limit (requests per IP per minute)
RATE_LIMIT_RPM=20

# Web server
PORT=8000
